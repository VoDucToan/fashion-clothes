generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

model SiteUser {
  id           String @id @default(uuid(7)) @db.Uuid
  emailAddress String @unique @map("email_address")
  phoneNumber  String @map("phone_number")
  password     String

  addresses      UserAddress[]
  paymentMethods UserPaymentMethod[]
  carts          ShoppingCart[]
  orders         ShopOrder[]
  reviews        UserReview[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@map("site_user")
}

model Country {
  id          String @id @default(uuid(7)) @db.Uuid
  countryName String @map("country_name")

  addresses Address[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@map("country")
}

model Address {
  id           String  @id @default(uuid(7)) @db.Uuid
  unitNumber   String? @map("unit_number")
  streetNumber String? @map("street_number")
  addressLine1 String  @map("address_line1")
  addressLine2 String? @map("address_line2")
  city         String
  region       String
  postalCode   String  @map("postal_code")
  countryId    String  @map("country_id") @db.Uuid

  country       Country       @relation(fields: [countryId], references: [id], onDelete: Restrict)
  users         UserAddress[]
  shippedOrders ShopOrder[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([countryId])
  @@map("address")
}

// Join table: a user keeps many addresses, an address can be shared.
model UserAddress {
  userId    String  @map("user_id") @db.Uuid
  addressId String  @map("address_id") @db.Uuid
  isDefault Boolean @default(false) @map("is_default")

  user    SiteUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  address Address  @relation(fields: [addressId], references: [id], onDelete: Cascade)

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@id([userId, addressId])
  @@index([addressId])
  @@map("user_address")
}

// ---------------------------------------------------------------------------
// Payment
// ---------------------------------------------------------------------------

model PaymentType {
  id    String @id @default(uuid(7)) @db.Uuid
  value String

  paymentMethods UserPaymentMethod[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@map("payment_type")
}

model UserPaymentMethod {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  paymentTypeId String   @map("payment_type_id") @db.Uuid
  provider      String
  accountNumber String   @map("account_number")
  expiryDate    DateTime @map("expiry_date") @db.Date
  isDefault     Boolean  @default(false) @map("is_default")

  user        SiteUser    @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id], onDelete: Restrict)
  orders      ShopOrder[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([userId])
  @@index([paymentTypeId])
  @@map("user_payment_method")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

// Self-referencing tree: parentCategoryId null = a root category.
model ProductCategory {
  id               String  @id @default(uuid(7)) @db.Uuid
  parentCategoryId String? @map("parent_category_id") @db.Uuid
  categoryName     String  @map("category_name")

  parent   ProductCategory?  @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryHierarchy")

  products   Product[]
  variations Variation[]
  promotions PromotionCategory[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([parentCategoryId])
  @@map("product_category")
}

// The sellable concept ("Oversized Hoodie"), not the thing with a barcode.
model Product {
  id           String  @id @default(uuid(7)) @db.Uuid
  categoryId   String  @map("category_id") @db.Uuid
  name         String
  description  String?
  productImage String  @map("product_image")

  category ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items    ProductItem[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([categoryId])
  @@map("product")
}

// The concrete SKU ("Oversized Hoodie / Black / M") — stock and price live here.
model ProductItem {
  id           String  @id @default(uuid(7)) @db.Uuid
  productId    String  @map("product_id") @db.Uuid
  sku          String  @unique
  qtyInStock   Int     @map("qty_in_stock")
  productImage String  @map("product_image")
  price        Decimal @db.Decimal(10, 2)

  product        Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  configurations ProductConfiguration[]
  cartItems      ShoppingCartItem[]
  orderLines     OrderLine[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([productId])
  @@map("product_item")
}

// An axis of choice for a category: "Colour", "Size".
model Variation {
  id         String @id @default(uuid(7)) @db.Uuid
  categoryId String @map("category_id") @db.Uuid
  name       String

  category ProductCategory   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  options  VariationOption[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([categoryId])
  @@map("variation")
}

// One value on that axis: "Black", "M".
model VariationOption {
  id          String @id @default(uuid(7)) @db.Uuid
  variationId String @map("variation_id") @db.Uuid
  value       String

  variation      Variation              @relation(fields: [variationId], references: [id], onDelete: Cascade)
  configurations ProductConfiguration[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([variationId])
  @@map("variation_option")
}

// Join table: which options make up a given SKU.
model ProductConfiguration {
  productItemId     String @map("product_item_id") @db.Uuid
  variationOptionId String @map("variation_option_id") @db.Uuid

  productItem     ProductItem     @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  variationOption VariationOption @relation(fields: [variationOptionId], references: [id], onDelete: Cascade)

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@id([productItemId, variationOptionId])
  @@index([variationOptionId])
  @@map("product_configuration")
}

// ---------------------------------------------------------------------------
// Promotions
// ---------------------------------------------------------------------------

model Promotion {
  id           String   @id @default(uuid(7)) @db.Uuid
  name         String
  description  String?
  discountRate Decimal  @map("discount_rate") @db.Decimal(5, 2)
  startDate    DateTime @map("start_date") @db.Date
  endDate      DateTime @map("end_date") @db.Date

  categories PromotionCategory[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@map("promotion")
}

// Join table: a promotion applies to many categories.
model PromotionCategory {
  categoryId  String @map("category_id") @db.Uuid
  promotionId String @map("promotion_id") @db.Uuid

  category  ProductCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  promotion Promotion       @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@id([categoryId, promotionId])
  @@index([promotionId])
  @@map("promotion_category")
}

// ---------------------------------------------------------------------------
// Cart
// ---------------------------------------------------------------------------

model ShoppingCart {
  id     String @id @default(uuid(7)) @db.Uuid
  userId String @map("user_id") @db.Uuid

  user  SiteUser           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items ShoppingCartItem[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([userId])
  @@map("shopping_cart")
}

model ShoppingCartItem {
  id            String @id @default(uuid(7)) @db.Uuid
  cartId        String @map("cart_id") @db.Uuid
  productItemId String @map("product_item_id") @db.Uuid
  qty           Int

  cart        ShoppingCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productItem ProductItem  @relation(fields: [productItemId], references: [id], onDelete: Restrict)

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  // Adding the same SKU twice bumps qty instead of making a second row.
  @@unique([cartId, productItemId])
  @@index([productItemId])
  @@map("shopping_cart_item")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

model ShippingMethod {
  id    String  @id @default(uuid(7)) @db.Uuid
  name  String
  price Decimal @db.Decimal(10, 2)

  orders ShopOrder[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@map("shipping_method")
}

model OrderStatus {
  id     String @id @default(uuid(7)) @db.Uuid
  status String

  orders ShopOrder[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@map("order_status")
}

model ShopOrder {
  id                String   @id @default(uuid(7)) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  orderDate         DateTime @default(now()) @map("order_date")
  paymentMethodId   String   @map("payment_method_id") @db.Uuid
  shippingAddressId String   @map("shipping_address") @db.Uuid
  shippingMethodId  String   @map("shipping_method") @db.Uuid
  orderTotal        Decimal  @map("order_total") @db.Decimal(10, 2)
  orderStatusId     String   @map("order_status") @db.Uuid

  // Restrict everywhere: an order is a financial record, nothing upstream
  // may delete it out from under itself.
  user            SiteUser          @relation(fields: [userId], references: [id], onDelete: Restrict)
  paymentMethod   UserPaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  shippingAddress Address           @relation(fields: [shippingAddressId], references: [id], onDelete: Restrict)
  shippingMethod  ShippingMethod    @relation(fields: [shippingMethodId], references: [id], onDelete: Restrict)
  orderStatus     OrderStatus       @relation(fields: [orderStatusId], references: [id], onDelete: Restrict)

  lines OrderLine[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([userId])
  @@index([orderStatusId])
  @@index([paymentMethodId])
  @@index([shippingAddressId])
  @@index([shippingMethodId])
  @@map("shop_order")
}

model OrderLine {
  id            String  @id @default(uuid(7)) @db.Uuid
  productItemId String  @map("product_item_id") @db.Uuid
  orderId       String  @map("order_id") @db.Uuid
  qty           Int
  // Price at purchase time — never read the live ProductItem.price for history.
  price         Decimal @db.Decimal(10, 2)

  productItem ProductItem  @relation(fields: [productItemId], references: [id], onDelete: Restrict)
  order       ShopOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reviews     UserReview[]

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([orderId])
  @@index([productItemId])
  @@map("order_line")
}

// ---------------------------------------------------------------------------
// Reviews
// ---------------------------------------------------------------------------

// Tied to an order_line, not a product: only buyers can review.
model UserReview {
  id               String  @id @default(uuid(7)) @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  orderedProductId String  @map("ordered_product_id") @db.Uuid
  ratingValue      Int     @map("rating_value")
  comment          String?

  user           SiteUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderedProduct OrderLine @relation(fields: [orderedProductId], references: [id], onDelete: Cascade)

  // Audit
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by") @db.Uuid
  updatedAt DateTime  @updatedAt @map("updated_at")
  updatedBy String?   @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  @@index([userId])
  @@index([orderedProductId])
  @@map("user_review")
}
