NODE_ENV=development

# API listens here; the Next.js app calls it through API_URL
PORT=4000

# Must match POSTGRES_* in the repo-root .env used by docker-compose
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fashion_clothes?schema=public"

# Comma-separated browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Turn off in production — a public API schema helps attackers more than users
SWAGGER_ENABLED=true
